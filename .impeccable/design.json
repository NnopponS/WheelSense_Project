      "refersTo": "chip-warning",
      "description": "Noninteractive clinical caution status.",
      "html": "<span class=\"ds-chip\">Warning</span>",
      "css": ".ds-chip{display:inline-flex;align-items:center;min-height:24px;padding:4px 8px;border:1px solid color-mix(in oklab,var(--warning,#926315) 35%,transparent);border-radius:calc(var(--radius,.875rem) - .35rem);background:var(--warning-soft,#FFF5DF);color:var(--warning-foreground,#805311);font-family:var(--font-sans,sans-serif);font-size:.8125rem;font-weight:500;line-height:1.25;}"
    },
    {
      "name": "Operational Card",
      "kind": "card",
      "refersTo": "card",
      "description": "Quiet shared panel with source availability copy.",
      "html": "<section class=\"ds-card\"><h3 class=\"ds-card-title\">Care tasks</h3><p class=\"ds-card-copy\">Assigned work and its recorded status.</p></section>",
      "css": ".ds-card{min-width:0;padding:20px;border:1px solid var(--border,#E3E7ED);border-radius:var(--radius,.875rem);background:var(--card,#fff);color:var(--card-foreground,#121820);box-shadow:var(--shadow-card,0 1px 2px rgb(18 24 32/.025));font-family:var(--font-sans,sans-serif);}.ds-card-title{margin:0;font-size:1.125rem;font-weight:600;line-height:1.55;letter-spacing:-.025em;}.ds-card-copy{margin:8px 0 0;font-size:.9375rem;line-height:1.625;color:var(--muted-foreground,#626C78);}"
    },
    {
      "name": "Graphite Insight",
      "kind": "custom",
      "refersTo": "insight",
      "description": "Scoped historical analytics with availability shown explicitly.",
      "html": "<section class=\"ds-insight\"><h3 class=\"ds-insight-title\">Historical trends</h3><p class=\"ds-insight-copy\">Recorded measurements · source timestamps retained</p><button class=\"ds-insight-choice\" type=\"button\" aria-pressed=\"true\">Heart rate</button></section>",
      "css": ".ds-insight{padding:20px;border:1px solid var(--insight-border,#35404C);border-radius:var(--radius,.875rem);background:var(--insight,#14181E);color:var(--insight-foreground,#F3F5F7);font-family:var(--font-sans,sans-serif);color-scheme:dark;}.ds-insight-title{margin:0;font-size:1rem;font-weight:600;}.ds-insight-copy{font-size:.9375rem;line-height:1.5;color:var(--insight-muted,#ADB8C5);}.ds-insight-choice{min-height:44px;border:1px solid var(--chart-1,#B7F36B);border-radius:calc(var(--radius,.875rem) - .15rem);padding:8px 12px;background:var(--chart-1,#B7F36B);color:var(--insight,#14181E);font:inherit;font-size:.9375rem;font-weight:600;cursor:pointer;}.ds-insight-choice:hover{background:var(--chart-1,#B7F36B);}.ds-insight-choice:focus-visible{outline:2px solid var(--chart-1,#B7F36B);outline-offset:3px;}"
    },
    {
      "name": "Bounded Workspace",
      "kind": "custom",
      "description": "Source pattern: RoleShell, AppPage workspace opt-in and globals.css. Persistent chrome, compact controls, remaining-height primary surface; mobile natural flow.",
      "html": "<section class=\"ds-workspace\"><header>Work</header><div class=\"ds-workspace-body\" tabindex=\"0\" aria-label=\"Task workspace\">Assigned work</div></section>",
      "css": ".ds-workspace{display:flex;min-width:0;flex-direction:column;gap:.75rem;color:var(--foreground);background:var(--background)}.ds-workspace-body{min-width:0}.ds-workspace-body:focus-visible{outline:2px solid var(--ring);outline-offset:-2px}@media(min-width:1024px) and (min-height:640px){.ds-workspace{height:100%;min-height:0}.ds-workspace>header{flex-shrink:0}.ds-workspace-body{flex:1;min-height:0;overflow:auto}}"
