  "narrative": {
    "northStar": "Calm care operations, focused analytics",
    "overview": "WheelSense joins calm, precise care operations with deep graphite health analytics. Its original identity follows the user-confirmed Apple clarity × WHOOP analytics direction: cool operational surfaces, restrained blue actions, ruled directories, and focused dark insight workspaces. It is an operational care tool used under time pressure.\n\nResident identity, urgent attention and a safe next action lead each workspace. Recorded, unavailable and simulated information remain distinguishable. Existing roles, backend behavior and complete workflows constrain the visual system; conceptual imagery is directional evidence only.",
    "keyCharacteristics": [
      "Quiet operational chrome and compact, readable task workspaces.",
      "Semantic status colors separated from historical data-series colors.",
      "System typography with Thai coverage, responsive role navigation and room directories.",
      "Source-backed clinical information with visible timestamps and availability."
    ],
    "rules": [
      {
        "name": "The Clinical Meaning Rule",
        "body": "Use semantic status tokens for severity; lime, cyan, amber and lavender chart series identify measurements, not clinical status.",
        "section": "colors"
      },
      {
        "name": "The Scoped Insight Rule",
        "body": "Graphite analytics redefine semantic foreground, surface, border and focus tokens locally so child controls inherit the insight context in both themes.",
        "section": "colors"
      },
      {
        "name": "The One Type System Rule",
        "body": "Use the user-confirmed platform system stack with the existing Noto Sans Thai fallback. Keep numeric columns tabular; do not scale the type ramp with viewport width.",
        "section": "typography"
      },
      {
        "name": "The Quiet Surface Rule",
        "body": "Operational panels stay quiet at rest and on hover. Use the elevated shadow for overlays; do not add decorative gradients or glass to content panels.",
        "section": "elevation"
      },
      {
        "name": "The Remaining Viewport Rule",
        "body": "At widths of at least 1024px, use a 100dvh shell and min-height:0 flex chain below persistent navigation. AppPage workspace surfaces bound their primary panes at heights of at least640px. Smaller screens use natural flow; short desktop screens keep a reachable main scroller. Never hide overflow to conceal unreachable content.",
        "section": "layout"
      }
    ],
    "dos": [
      "Do use semantic tokens and shared primitives so light, dark and insight contexts stay coordinated.",
      "Do keep urgent actions, resident identity, timestamps and data availability readable before secondary analysis.",
      "Do retain labeled severity states, visible keyboard focus, reduced-motion behavior and Thai text coverage.",
      "Do use compact rows on desktop and labeled mobile records or room directories where the wide view cannot fit.",
      "Do use contextual task and schedule sheets, restore trigger focus, and preserve keyboard access to independently scrolling panes.",
      "Do distinguish popup dismissal from clinical acknowledgment or confirmed resolution; keep simulation labels and saved sound preferences visible."
    ],
    "donts": [
      "Don't substitute chart colors for clinical severity or turn absent readings into normal, live or zero readings.",
      "Don't place decorative hero content, nested presentation cards or page-load choreography ahead of operational work.",
      "Don't hide or replace primary emergency controls with AI; mutating AI actions retain explicit confirmation.",
      "Don't copy conceptual readings or service-health claims into the product, or treat screenshots as accessibility proof."
    ]
  }
