  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Shared primary action variant.",
      "html": "<button type=\"button\" class=\"ds-button ds-button-primary\">Save changes</button>",
      "css": ".ds-button{display:inline-flex;align-items:center;justify-content:center;min-height:44px;padding:10px 16px;border-radius:var(--radius-control,.5rem);border:1px solid transparent;transition:color 150ms,background-color 150ms,border-color 150ms,box-shadow 150ms;font-family:var(--font-sans, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif);font-size:.9375rem;font-weight:600;line-height:1;cursor:pointer;}.ds-button:focus-visible{box-shadow:0 0 0 2px var(--card,#fff),0 0 0 4px var(--ring,#1769E0);outline:none;}.ds-button:disabled{pointer-events:none;background:var(--ws-disabled-surface,#EDF0F4);color:var(--ws-disabled-foreground,#626C78);}@media(prefers-reduced-motion:reduce){.ds-button{transition:none;}}.ds-button-primary{background:var(--primary,#1769E0);color:var(--primary-foreground,#fff);}.ds-button-primary:hover{background:color-mix(in oklab,var(--primary,#1769E0) 90%,transparent);}.ds-button-primary:active{background:color-mix(in oklab,var(--primary,#1769E0) 80%,transparent);}"
    },
