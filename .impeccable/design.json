      "html": "<input class=\"ds-input\" aria-label=\"Search residents\" placeholder=\"Search residents\">",
      "css": ".ds-input{width:100%;height:48px;border:1px solid var(--input,#fff);border-radius:var(--radius,.875rem);background:var(--input,#fff);color:var(--foreground,#121820);padding:12px 16px;font-family:var(--font-sans,sans-serif);font-size:1rem;line-height:1.6;box-shadow:0 1px 3px 0 rgb(0 0 0/.1),0 1px 2px -1px rgb(0 0 0/.1);transition:border-color 150ms,box-shadow 150ms;}.ds-input::placeholder{color:var(--muted-foreground,#626C78);}.ds-input:focus-visible{border-color:var(--ring,#1769E0);box-shadow:0 0 0 2px var(--card,#fff),0 0 0 4px var(--ring,#1769E0);outline:none;}.ds-input:disabled{opacity:.5;cursor:not-allowed;}@media(prefers-reduced-motion:reduce){.ds-input{transition:none;}}"
    },
    {
      "name": "Active Navigation",
      "kind": "nav",
      "refersTo": "nav-active",
      "description": "Selected desktop role destination, with text and SVG icon.",
      "html": "<nav aria-label=\"Example navigation\"><a class=\"ds-nav\" href=\"#residents\" aria-current=\"page\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><path d=\"M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2M16 3a4 4 0 0 1 0 8M22 21v-2a4 4 0 0 0-3-3.87\"/><circle cx=\"9\" cy=\"7\" r=\"4\"/></svg>Residents</a></nav>",
      "css": ".ds-nav{display:flex;align-items:center;gap:12px;min-height:44px;padding:8px 12px;border-radius:calc(var(--radius,.875rem) - .15rem);background:var(--ws-selected-surface,#EAF2FF);color:var(--ws-selected-foreground,#1459BE);font-family:var(--font-sans,sans-serif);font-size:.9375rem;font-weight:500;line-height:1.5;text-decoration:none;}.ds-nav svg{color:var(--primary,#1769E0);flex-shrink:0;}.ds-nav:focus-visible{box-shadow:0 0 0 2px var(--card,#fff),0 0 0 4px var(--ring,#1769E0);outline:none;}"
    },
    {
