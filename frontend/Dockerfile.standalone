FROM node:20-alpine
WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=80
ENV HOSTNAME=0.0.0.0
ENV WHEELSENSE_API_ORIGIN=http://backend:8000

COPY package.json ./
COPY public ./public
COPY .next/standalone ./
COPY .next/static ./.next/static

EXPOSE 80

CMD ["node", "server.js"]
